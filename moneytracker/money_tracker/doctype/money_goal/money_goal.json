   "fieldname": "target_percent",
   "fieldtype": "Percent",
   "label": "Target Percent",
   "mandatory_depends_on": "eval:doc.goal_type == \"Savings Rate Target\""
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "Currency",
   "options": "Currency"
  },
  {
   "fieldname": "column_break_target",
   "fieldtype": "Column Break"
