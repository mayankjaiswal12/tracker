   "fieldname": "start_date",
   "fieldtype": "Date",
   "label": "Start Date",
   "reqd": 1
  },
  {
   "description": "The deadline. Required where the goal is about a period rather than a balance.",
   "fieldname": "target_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "label": "Target Date"
  },
  {
   "depends_on": "eval:[\"Savings\", \"Debt Payoff\"].includes(doc.goal_type)",
   "fieldname": "measurement_section",
   "fieldtype": "Section Break",
   "label": "Measurement"
  },
  {
   "depends_on": "eval:[\"Savings\", \"Debt Payoff\"].includes(doc.goal_type)",
