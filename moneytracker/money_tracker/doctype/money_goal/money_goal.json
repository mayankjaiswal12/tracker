   "fieldtype": "Currency",
   "in_list_view": 1,
   "label": "Target Amount",
   "mandatory_depends_on": "eval:doc.goal_type != \"Savings Rate Target\"",
   "options": "currency"
  },
  {
   "depends_on": "eval:doc.goal_type == \"Savings Rate Target\"",
