   "fieldname": "target_account",
   "fieldtype": "Link",
   "label": "Target Account",
   "mandatory_depends_on": "eval:[\"Savings\", \"Debt Payoff\"].includes(doc.goal_type)",
   "options": "Money Account"
  },
  {
   "default": "Contributions Since Start",
   "depends_on": "eval:doc.goal_type == \"Savings\"",
   "description": "Contributions Since Start counts only what has gone in since the start date. Account Balance counts everything the account holds, which suits a pot kept for this goal alone.",
   "fieldname": "measure_basis",
   "fieldtype": "Select",
   "label": "Measure Basis",
   "options": "Contributions Since Start\nAccount Balance"
  },
  {
   "fieldname": "column_break_measurement",
   "fieldtype": "Column Break"
  },
  {
   "depends_on": "eval:doc.goal_type == \"Debt Payoff\" || (doc.goal_type == \"Savings\" && doc.measure_basis != \"Account Balance\")",
   "description": "For a Savings goal, money already put aside before the start date — including money saved outside this app. For a Debt Payoff, what was owed when the goal started; left empty it is read from the ledger.",
   "fieldname": "opening_amount",
   "fieldtype": "Currency",
   "label": "Opening Amount",
